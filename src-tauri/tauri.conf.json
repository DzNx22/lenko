{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LENKO",
  "version": "0.1.0",
  "identifier": "com.lenko.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LENKO",
        "width": 240,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyREY4ODc5RkMzMkQ5NDkKUldSSjJUTDhlWWpma2owZjVkMHFua0Q3UkZDdjFFcEhGUG1xak9VY2RteVBOUlZMdHRHNkN4Y28K",
      "endpoints": [
        "https://github.com/DzNx22/lenko/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
